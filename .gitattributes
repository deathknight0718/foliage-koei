# All text files use LF by default
* text=auto eol=lf

# PowerShell scripts use CRLF
*.ps1 text eol=crlf

# Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.so binary
*.dll binary
*.exe binary
*.wasm binary
*.data binary