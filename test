#pragma endian little

struct Flag { u8 lp00[0x0000ABE0]; };

struct Head {
    u32 id;
    u32 size;
};

struct Record {
  // u8 lp00[0x016b];
  char16 family_name[0x0012 / 2];
  char16 given_name[0x0012 / 2];
  char16 courtesy_name[0x0012 / 2];
  char16 enunciation[0x0096 / 2];
  u8 skip[0x016b - 0x0012 - 0x0012 - 0x0012 - 0x0096];
};

Flag flag @ $;
Head head @ $;
Record records[head.size] @ $;